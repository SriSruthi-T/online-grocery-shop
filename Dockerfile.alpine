FROM alpine:3.18
LABEL description="Lightweight Grocery Shop on Alpine"
RUN apk add --no-cache openjdk11-jre curl
ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk
ENV PATH=$JAVA_HOME/bin:$PATH
RUN wget -q https://archive.apache.org/dist/tomcat/tomcat-9/v9.0.78/bin/apache-tomcat-9.0.78.tar.gz && \
    tar xzf apache-tomcat-9.0.78.tar.gz -C /opt/ && \
    mv /opt/apache-tomcat-9.0.78 /opt/tomcat && \
    rm apache-tomcat-9.0.78.tar.gz && rm -rf /opt/tomcat/webapps/*
COPY target/online-grocery-shop.war /opt/tomcat/webapps/ROOT.war
EXPOSE 8080
CMD ["/opt/tomcat/bin/catalina.sh", "run"]