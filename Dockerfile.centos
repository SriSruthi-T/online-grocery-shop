FROM centos:7
LABEL description="Enterprise Grocery Shop on CentOS"
RUN yum update -y && \
    yum install -y java-11-openjdk java-11-openjdk-devel wget curl && \
    yum clean all
ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk
ENV PATH=$JAVA_HOME/bin:$PATH
RUN wget -q https://archive.apache.org/dist/tomcat/tomcat-9/v9.0.78/bin/apache-tomcat-9.0.78.tar.gz && \
    tar xzf apache-tomcat-9.0.78.tar.gz -C /opt/ && \
    mv /opt/apache-tomcat-9.0.78 /opt/tomcat && \
    rm apache-tomcat-9.0.78.tar.gz
COPY target/online-grocery-shop.war /opt/tomcat/webapps/
EXPOSE 8080
CMD ["/opt/tomcat/bin/catalina.sh", "run"]